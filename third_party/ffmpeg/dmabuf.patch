+static int v4l2_export_buffer(V4L2Buffer *buffer)
+{
+    struct v4l2_pix_format_mplane *f = &buffer->context->format.fmt.pix_mp;
+    AVDRMFrameDescriptor *drm = &buffer->drm;
+    size_t pitch = f->plane_fmt[0].bytesperline;
+    size_t offset = pitch * f->height;
+    struct v4l2_exportbuffer exp = {
+        .type = buffer->context->type,
+        .index = buffer->buf.index,
+        .flags = O_CLOEXEC | O_RDWR,
+    };
+    off_t size;
+    uint64_t modifier = 0;
+    uint32_t format = V4L2_PIX_FMT_NV12;
+
+    if (buffer->num_planes != 1)
+        return AVERROR(ENOSYS);
+    if (f->pixelformat == v4l2_fourcc('Q', '1', '0', 'C')) {
+        size_t meta_stride = FFALIGN((f->width + 47) / 48, 64);
+        size_t meta_height = FFALIGN((f->height + 3) / 4, 16);
+        offset = FFALIGN(meta_stride * meta_height, 4096) + FFALIGN(offset, 4096);
+        modifier = UINT64_C(0x0500000000000001);
+        format = v4l2_fourcc('P', '0', '1', '0');
+    } else if (f->pixelformat != V4L2_PIX_FMT_NV12) {
+        return AVERROR(ENOSYS);
+    }
+    if (!pitch || offset >= buffer->plane_info[0].length)
+        return AVERROR_INVALIDDATA;
+    if (ioctl(buf_to_m2mctx(buffer)->fd, VIDIOC_EXPBUF, &exp))
+        return AVERROR(errno);
+    size = lseek(exp.fd, 0, SEEK_END);
+    if (size < 0 || (uint64_t)size < buffer->plane_info[0].length || lseek(exp.fd, 0, SEEK_SET) < 0) {
+        close(exp.fd);
+        return AVERROR_INVALIDDATA;
+    }
+    drm->nb_objects = drm->nb_layers = 1;
+    drm->objects[0] = (AVDRMObjectDescriptor){exp.fd, size, modifier};
+    drm->layers[0].format = format;
+    drm->layers[0].nb_planes = 2;
+    drm->layers[0].planes[0] = (AVDRMPlaneDescriptor){0, 0, pitch};
+    drm->layers[0].planes[1] = (AVDRMPlaneDescriptor){0, offset, pitch};
+    return 0;
+}
