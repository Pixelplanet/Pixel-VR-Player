#version 450

// 3D Autofocus: block matching around the gaze point between the two eye images of a stereo
// 180 / 360 equirect video (docs/concepts/AUTOFOCUS_PLAN_2026-11-19.md). One workgroup: the
// left strip and the right strip go into shared memory once, then each thread scores one
// disparity (candidate) with zero-mean NCC, its left window s / 2 right of the gaze point and
// its right window s / 2 left of it. Constants, sampling rule and sign convention:
// src/gfx/stereo_disparity.hpp (referenceScores is the CPU twin of this shader).

layout(local_size_x = 128) in;

// The sphere draw's video set; only binding 0 is read (luma, RGBA, or a Y'CbCr sampler).
layout(set = 0, binding = 0) uniform sampler2D video;

layout(std430, set = 1, binding = 0) writeonly buffer FocusOut {
    float scores[128];
    float variance;
    uint serial;
} outBuf;

layout(push_constant) uniform Push {
    float lon0Deg;
    float lat0Deg;
    float uvScaleX;
    float uvScaleY;
    int projection;  // 1 = 360, 2 = 180
    int stereo;      // 1 = side by side, 2 = top / bottom
    int leftHalf;    // the half shown to the left eye
    int lumaOnly;    // 1 = luma texture (.r), 0 = RGB
    uint serial;
} pc;

const int kWinW = 24;
const int kWinH = 16;
const int kCandidates = 128;
const int kZeroCandidate = 16;
const int kHalfStripW = 2 * (kWinW - 1) + kCandidates;                       // 174
const int kLeftStripOff = (kWinW - 1) + kZeroCandidate;                      // 39
const int kRightStripOff = (kCandidates - 1) + (kWinW - 1) - kZeroCandidate;  // 134
const float kPitchXDeg = 4.0 / 24.0;
const float kPitchYDeg = 3.0 / 16.0;
const float kHalfPitchXDeg = 0.5 * kPitchXDeg;
const float kOutside = -1.0;  // a sample past the 180 picture's side edge

// 4 * (2 * 16 * 174 + 3 * 128) = 23808 bytes (stereo::kSharedBytes; the renderer checks the limit).
shared float sLeft[kWinH * kHalfStripW];
shared float sRight[kWinH * kHalfStripW];
shared float sScore[kCandidates];
shared float sVar[kCandidates];
shared uint sOk[kCandidates];

// sourceUv() of the header, then the crop, then a bilinear read as luma.
float lumaAt(float lonDeg, float latDeg, int side) {
    float span = (pc.projection == 2) ? 180.0 : 360.0;
    float u = lonDeg / span + 0.5;
    float v = 0.5 - latDeg / 180.0;
    if (pc.projection == 2) {
        if (u < 0.0 || u > 1.0) return kOutside;  // (the sphere draws black there)
    } else {
        u = fract(u);  // 360 wraps within the half
    }
    if (pc.stereo == 2) {
        v = v * 0.5 + float(side) * 0.5;
    } else if (pc.stereo == 1) {
        u = u * 0.5 + float(side) * 0.5;
    }
    // Compute shaders have no implicit LOD: level 0, as texture() picks for the sphere.
    vec4 t = textureLod(video, vec2(u, v) * vec2(pc.uvScaleX, pc.uvScaleY), 0.0);
    return (pc.lumaOnly != 0) ? t.r : dot(t.rgb, vec3(0.299, 0.587, 0.114));
}

void main() {
    int t = int(gl_LocalInvocationID.x);
    float cy = 0.5 * float(kWinH - 1);
    int rightHalf = 1 - pc.leftHalf;

    // Strip column k: candidate c, window column i reads left 2 i + c, right 2 i - c + 127.
    for (int idx = t; idx < kWinH * kHalfStripW; idx += kCandidates) {
        int k = idx % kHalfStripW;
        int j = idx / kHalfStripW;
        float lat = pc.lat0Deg - (float(j) - cy) * kPitchYDeg;
        sLeft[idx] = lumaAt(pc.lon0Deg + float(k - kLeftStripOff) * kHalfPitchXDeg, lat, pc.leftHalf);
        sRight[idx] = lumaAt(pc.lon0Deg + float(k - kRightStripOff) * kHalfPitchXDeg, lat, rightHalf);
    }
    memoryBarrierShared();
    barrier();

    int c = t;
    bool inside = true;
    float sl = 0.0, sr = 0.0, sll = 0.0, srr = 0.0, slr = 0.0;
    for (int j = 0; j < kWinH; ++j) {
        int lrow = j * kHalfStripW + c;
        int rrow = j * kHalfStripW - c + (kCandidates - 1);
        for (int i = 0; i < kWinW; ++i) {
            float l = sLeft[lrow + 2 * i];
            float r = sRight[rrow + 2 * i];
            if (l < -0.5 || r < -0.5) inside = false;
            sl += l;
            sr += r;
            sll += l * l;
            srr += r * r;
            slr += l * r;
        }
    }
    float n = float(kWinW * kWinH);
    float num = slr - sl * sr / n;
    float dl = max(sll - sl * sl / n, 0.0);
    float dr = max(srr - sr * sr / n, 0.0);
    float den = sqrt(dl * dr);
    float score = (den < 1e-12) ? 0.0 : num / den;
    float mean = sl / n;
    // A window that leaves the 180 picture: NaN, which evaluateScores skips.
    outBuf.scores[c] = inside ? score : uintBitsToFloat(0x7fc00000u);
    sScore[c] = score;
    sVar[c] = max(sll / n - mean * mean, 0.0);  // never below 0 from rounding
    sOk[c] = inside ? 1u : 0u;
    memoryBarrierShared();
    barrier();

    if (t == 0) {
        // The left variance of the candidate evaluateScores picks (first highest, NaN skipped).
        int best = -1;
        for (int k = 0; k < kCandidates; ++k) {
            if (sOk[k] != 0u && (best < 0 || sScore[k] > sScore[best])) best = k;
        }
        outBuf.variance = (best < 0) ? 0.0 : sVar[best];
        outBuf.serial = pc.serial;
    }
}
